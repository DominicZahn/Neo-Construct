    <end_effector name="left_hand" parent_link="left_wrist_yaw_link" group="left_arm"/>
    <end_effector name="right_hand" parent_link="right_wrist_yaw_link" group="right_arm"/>
    <end_effector name="right_foot" parent_link="right_ankle_roll_link" group="right_leg"/>
    <end_effector name="left_foot" parent_link="left_ankle_roll_link" group="left_leg"/>

    <disable_collisions link1="left_hip_yaw_link" link2="left_knee_link" reason="Never"/>
    <disable_collisions link1="left_hip_yaw_link" link2="right_knee_link" reason="Never"/>
    <disable_collisions link1="left_hip_yaw_link" link2="torso_link" reason="Never"/>
    <disable_collisions link1="left_knee_link" link2="pelvis" reason="Never"/>
    <disable_collisions link1="pelvis" link2="right_hip_pitch_link" reason="Never"/>
    <disable_collisions link1="pelvis" link2="right_hip_roll_link" reason="Never"/>
    <disable_collisions link1="pelvis" link2="right_knee_link" reason="Never"/>
    <disable_collisions link1="pelvis" link2="torso_link" reason="Never"/>
</robot>
