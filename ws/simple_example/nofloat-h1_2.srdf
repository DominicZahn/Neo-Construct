<?xml version="1.0" encoding="UTF-8"?>
<robot name="h1_2">
    <group name="left_leg">
        <chain base_link="left_hip_yaw_link" tip_link="left_ankle_roll_link"/>
    </group>
    <group name="right_leg">
        <chain base_link="right_hip_yaw_link" tip_link="right_ankle_roll_link"/>
    </group>
    <group name="left_arm">
        <chain base_link="left_shoulder_pitch_link" tip_link="left_wrist_yaw_link"/>
    </group>
    <group name="right_arm">
        <chain base_link="right_shoulder_pitch_link" tip_link="right_wrist_yaw_link"/>
    </group>
    <group name="all">
        <group name="left_leg"/>
        <group name="right_leg"/>
        <group name="left_arm"/>
        <group name="right_arm"/>
    </group>
  <group_state name="knees_bend_0.2" group="all">
